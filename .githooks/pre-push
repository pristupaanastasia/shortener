#!/bin/sh
# Lint, test, enforce the coverage minimum and smoke-test the running service
# for the tip commit of every pushed branch.
# Enabled by `make hooks`. Skip in an emergency: git push --no-verify
#
# The tip commit is checked out into a temporary worktree, so the checks cover
# exactly what is pushed, not uncommitted changes in the working tree.
# Intermediate commits are not checked: running the full suite for each one
# would make pushes too slow. CI checks the tip as well.
set -e
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000

infra_up=false
if (cd "$root" && docker compose ps --status running --quiet 2>/dev/null | grep -q .); then
	infra_up=true
fi

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # deleting a remote branch

	dir="$(mktemp -d)"
	git worktree add --quiet --detach "$dir" "$local_sha"
	short="$(git rev-parse --short "$local_sha")"

	# Use the strongest check the commit's own Makefile provides: older commits
	# predate the coverage and test-integration targets.
	if make -C "$dir" -n coverage >/dev/null 2>&1; then
		if ! $infra_up; then
			git worktree remove --force "$dir"
			echo "pre-push: $local_ref ($short) requires the coverage check, which runs integration tests."
			echo "pre-push: start the infrastructure with \`make up\` and push again."
			exit 1
		fi
		targets="lint coverage"
		# Run the real service end to end when the commit has a smoke test.
		if make -C "$dir" -n smoke-full >/dev/null 2>&1; then
			targets="$targets smoke-full"
		fi
	elif $infra_up && make -C "$dir" -n test-integration >/dev/null 2>&1; then
		targets="lint test-integration"
	else
		targets="lint test"
	fi

	echo "pre-push: checking $local_ref ($short): $targets"
	if ! make -C "$dir" $targets; then
		git worktree remove --force "$dir"
		echo "pre-push: $local_ref failed the checks, push aborted"
		exit 1
	fi
	git worktree remove --force "$dir"
done
